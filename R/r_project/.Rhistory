glucose = c(80, 120, 150),
insulin = c(350, 400, 600),
sspg    = c(120, 150, 200)
)
# 3. On force l'ordre des colonnes pour qu'il soit identique aux features du Task
# (C'est souvent là que l'erreur de dimension se cache)
features <- getTaskFeatureNames(diabetesTask)
newFlowers <- newFlowers[, features, drop = FALSE]
# 4. Prédiction
prediction <- predict(knnModel, newdata = newFlowers)
getPredictionResponse(prediction)
