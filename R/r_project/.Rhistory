newFlowers <- data.frame(
Sepal.Length = c(5.1, 5.9, 6.9),
Sepal.Width  = c(3.5, 3.0, 3.1),
Petal.Length = c(1.4, 4.2, 5.4),
Petal.Width  = c(0.2, 1.5, 2.1)
)
# 2. Synchronisation forcée des types (Crucial pour mlr)
# On s'assure que les colonnes de 'newFlowers' sont typées comme celles de 'iris'
newFlowers <- mlr::fixFactors(newFlowers, iris)
